# Copy to .env before running the API. Values below match docker-compose.yml.

# Connection used by migrations and seeding. Must own the schema.
ADMIN_DATABASE_URL=postgres://postgres:postgres@localhost:5432/refunds

# Connection used by the running API. This role is granted INSERT/SELECT (never
# UPDATE/DELETE) on audit_log, which is what makes the audit trail append-only.
DATABASE_URL=postgres://refunds_app:refunds_app@localhost:5432/refunds

PORT=3001
# Origin allowed to call the API with cookies (the Vite dev server).
CORS_ORIGIN=http://localhost:5173
# Replace with a long random string outside of local development.
SESSION_SECRET=dev-only-insecure-session-secret
# Number of reverse proxy hops in front of the API. Leave at 0 unless a proxy
# you control sets X-Forwarded-For, otherwise clients can forge the audited IP.
TRUST_PROXY=0
NODE_ENV=development

# Password given to all three seeded users. Development convenience only.
SEED_PASSWORD=Password123!
